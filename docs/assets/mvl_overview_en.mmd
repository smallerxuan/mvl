flowchart LR
    subgraph L["LVGL main task, the only task that calls lv_*()"]
        V["View, lv_*() calls"]
    end

    T["any task / ISR"] -->|"function and context"| MSG["mvl_msg<br>message queue"]
    MSG -->|"single-writer consumption"| V
    B["background tasks"] -->|"write state"| M["Model<br>state"]
    M -->|"state change"| EVT["mvl_evt<br>event bus"]
    EVT -->|"dispatch to subscriber context"| VM["ViewModel"]
    VM -.->|"read snapshot"| M
    VM -->|"View interface"| V

    classDef lvgl fill:#E6F6EC,stroke:#3FA66A,color:#1D4D33;
    classDef store fill:#FFF4DC,stroke:#D9A13B,color:#5C4310;
    classDef bus fill:#EFE8FF,stroke:#7A5CD6,color:#3D2E73;
    classDef danger fill:#FDE8E8,stroke:#D64545,color:#7A1F1F;
    class L,V lvgl;
    class MSG,EVT bus;
    class M store;
