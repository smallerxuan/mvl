%%{init: {"theme":"base","flowchart":{"curve":"linear","nodeSpacing":30,"rankSpacing":45},"themeVariables":{"fontSize":"15px","primaryColor":"#EAF2FF","primaryBorderColor":"#4C7DD9","primaryTextColor":"#20304D","lineColor":"#8A97AD","clusterBkg":"#F5F8FF","clusterBorder":"#C9DBF7","edgeLabelBackground":"#FFFFFF"}}}%%
flowchart TB
    subgraph LV["LVGL 主任务（唯一允许调用 lv_*() 的上下文）"]
        direction LR
        VM["ViewModel<br>订阅回调"]
        VI["View 接口层<br>唯一认识 ui_ 控件"]
        VW["View<br>GUI Guider widgets<br>+ 事件绑定"]
    end

    subgraph DEC["解耦层"]
        direction LR
        MDL["Model<br>状态中心 · 互斥保护<br>唯一权威数据源"]
        EVT["mvl_evt（库提供）<br>事件总线<br>按订阅者声明的上下文路由"]
    end

    subgraph BG["后台任务 / ISR（任意上下文，不认识 UI）"]
        SRC["传感器任务 · 网络任务 · 按键处理 …"]
    end

    VW --- VI
    VI --- VM
    VM ===|"③ 状态事件经 mvl_msg 投递 ▲"| EVT
    VW -.-|"④ 用户操作 → 发布命令事件 ▼"| EVT
    EVT ===|"② 变更即发布状态事件"| MDL
    EVT -.-|"⑤ 命令事件投递到任务队列 ▼"| SRC
    MDL ===|"① set_xxx() 写状态 ▲"| SRC

    classDef bandStore fill:#FFFBF0,stroke:#E8C97A,color:#5C4310;
    classDef bandLvgl fill:#F0FAF4,stroke:#8FCBA8,color:#1D4D33;
    classDef store fill:#FFF4DC,stroke:#D9A13B,color:#5C4310;
    classDef bus fill:#EFE8FF,stroke:#7A5CD6,color:#3D2E73;
    class LV bandLvgl;
    class DEC bandStore;
    class MDL store;
    class EVT bus;
